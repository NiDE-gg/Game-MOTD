{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-motd",
  "compatibility_date": "2026-09-01",
  // Static-only Worker: no script, everything is served from ./public
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
